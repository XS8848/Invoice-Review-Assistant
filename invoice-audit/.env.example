# 复制为 .env 并填写真实值（.env 不入库）
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-strong
MINIO_BUCKET=reimb-invoices
MINIO_SECURE=false

# MySQL 生产 / SQLite 开发回退
DATABASE_URL=mysql+pymysql://invoice:CHANGE_ME@127.0.0.1:3306/invoice_audit?charset=utf8mb4
# DATABASE_URL=sqlite:////home/backer/invoice-audit/invoice_audit.db

APP_HOST=0.0.0.0
APP_PORT=8000
JWT_SECRET=please-change-me
JWT_EXPIRE_MINUTES=720
UPLOAD_MAX_FILES=20
UPLOAD_MAX_SIZE_MB=20
OCR_WORKERS=1
LLM_WORKERS=2

# ===== 分布式部署：组件通信地址（FastAPI 服务化）=====
# 留空 = 内嵌模式（单机默认）；填写 = 远程调用独立组件服务
OCR_SERVICE_URL=
LLM_SERVICE_URL=
OCR_SERVER_PORT=8101
LLM_SERVER_PORT=8102
TEMP_DIR=
